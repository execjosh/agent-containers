FROM ghcr.io/anomalyco/opencode:1.18.19@sha256:9d4081da17def820d8aaa4cff2389ab17be0d39c4b4d4ade50757ced2f2d890f

# Run as non-root with writable HOME for opencode config/auth cache.
# Podman rootless maps host UID; use a generic uid/gid that plays well with
# `--userns=keep-id`. When mounting the workspace, pass `--userns=keep-id`
# so file ownership matches the host user.
ARG USER=opencode
ARG UID=1000
ARG GID=1000

USER root
RUN addgroup -g "${GID}" "${USER}" && \
    adduser -u "${UID}" -G "${USER}" -h "/home/${USER}" -s /bin/sh -D "${USER}" && \
    mkdir -p /workspace \
        "/home/${USER}/.config" \
        "/home/${USER}/.local/share" \
        "/home/${USER}/.local/state" \
        "/home/${USER}/.cache" && \
    chown -R "${UID}:${GID}" /workspace "/home/${USER}"

# Go toolchain (linux-arm64, Apple Silicon hosts).
# Official Go tarball is glibc-built but the `go` binary runs fine on musl
# for pure-Go workloads. CGO builds would need extra libc shims.
ARG GO_VERSION=1.26.5
ARG GO_SHA256=fe4789e92b1f33358680864bbe8704289e7bb5fc207d80623c308935bd696d49
RUN apk add --no-cache ca-certificates
RUN wget -qO /tmp/go.tar.gz "https://go.dev/dl/go${GO_VERSION}.linux-arm64.tar.gz" && \
    echo "${GO_SHA256}  /tmp/go.tar.gz" | sha256sum -c - && \
    tar -C /usr/local -xzf /tmp/go.tar.gz && \
    rm /tmp/go.tar.gz && \
    ln -s /usr/local/go/bin/go /usr/local/bin/go && \
    ln -s /usr/local/go/bin/gofmt /usr/local/bin/gofmt

# Go developer tools, installed to a shared location so non-root user can
# run them without re-downloading. GOFLAGS=-mod=mod avoids module conflicts
# during install.
ENV GOTOOLDIR=/usr/local/gotools
RUN mkdir -p "${GOTOOLDIR}/bin" && \
    GOPATH=/tmp/gopath GOBIN="${GOTOOLDIR}/bin" GOMODCACHE=/tmp/gomodcache \
        go install golang.org/x/tools/gopls@latest && \
    GOPATH=/tmp/gopath GOBIN="${GOTOOLDIR}/bin" GOMODCACHE=/tmp/gomodcache \
        go install honnef.co/go/tools/cmd/staticcheck@latest && \
    GOPATH=/tmp/gopath GOBIN="${GOTOOLDIR}/bin" GOMODCACHE=/tmp/gomodcache \
        go install golang.org/x/tools/cmd/goimports@latest && \
    rm -rf /tmp/gopath /tmp/gomodcache && \
    chmod -R a+rx "${GOTOOLDIR}"

# Distro packages.
RUN apk add --no-cache \
        bash \
        btrfs-progs-dev \
        build-base \
        gpgme-dev \
        gcc \
        git \
        jq \
        linux-headers \
        make \
        musl-dev \
        openjpeg-tools \
        pkgconf \
        tar \
        yq

ARG BUN_VERSION=1.3.14
ARG TARGETARCH
COPY bun-release-key.asc /tmp/bun-release-key.asc
RUN set -eux; \
    apk add --no-cache --virtual .bun-build-deps gnupg unzip; \
    GNUPGHOME="$(mktemp -d)"; export GNUPGHOME; \
    extract_dir="$(mktemp -d)"; \
    case "${TARGETARCH:-arm64}" in \
        amd64) BUN_ARCHIVE=bun-linux-x64-musl.zip ;; \
        arm64) BUN_ARCHIVE=bun-linux-aarch64-musl.zip ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    wget -qO /tmp/SHASUMS256.txt.asc "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/SHASUMS256.txt.asc"; \
    gpg --batch --import /tmp/bun-release-key.asc; \
    test "$(gpg --batch --with-colons --fingerprint F3DCC08A8572C0749B3E18888EAB4D40A7B22B59 | grep -c '^fpr:::::::::F3DCC08A8572C0749B3E18888EAB4D40A7B22B59:')" = 1; \
    gpg --batch --status-fd 1 --verify /tmp/SHASUMS256.txt.asc > /tmp/bun-gpg.status 2>/tmp/bun-gpg.log; \
    grep -F '[GNUPG:] GOODSIG 8EAB4D40A7B22B59 Robobun <robobun@oven.sh>' /tmp/bun-gpg.status; \
    grep -F '[GNUPG:] VALIDSIG F3DCC08A8572C0749B3E18888EAB4D40A7B22B59 ' /tmp/bun-gpg.status; \
    gpg --batch --decrypt /tmp/SHASUMS256.txt.asc > /tmp/SHASUMS256.txt; \
    BUN_SHA256="$(grep -F "  ${BUN_ARCHIVE}" /tmp/SHASUMS256.txt | cut -d ' ' -f 1)"; \
    test -n "${BUN_SHA256}"; \
    wget -qO /tmp/bun.zip "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/${BUN_ARCHIVE}"; \
    echo "${BUN_SHA256}  /tmp/bun.zip" | sha256sum -c -; \
    unzip -q /tmp/bun.zip -d "${extract_dir}"; \
    install -m 0755 "${extract_dir}/${BUN_ARCHIVE%.zip}/bun" /usr/local/bin/bun; \
    test "$(bun --version)" = "${BUN_VERSION}"; \
    apk del .bun-build-deps; \
    rm -rf "$GNUPGHOME" "${extract_dir}" /tmp/bun.zip /tmp/bun-gpg.log /tmp/bun-gpg.status /tmp/bun-release-key.asc /tmp/SHASUMS256.txt /tmp/SHASUMS256.txt.asc

USER ${UID}:${GID}
ENV HOME=/home/${USER} \
    XDG_CONFIG_HOME=/home/${USER}/.config \
    XDG_DATA_HOME=/home/${USER}/.local/share \
    XDG_STATE_HOME=/home/${USER}/.local/state \
    XDG_CACHE_HOME=/home/${USER}/.cache \
    GOPATH=/home/${USER}/go \
    PATH=/usr/local/go/bin:/usr/local/gotools/bin:/home/${USER}/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    TERM=xterm-256color

WORKDIR /workspace

ENTRYPOINT ["opencode"]
