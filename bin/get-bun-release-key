#!/bin/bash

bunversion='1.3.14'
fingerprint=$(curl -Ss "https://raw.githubusercontent.com/oven-sh/bun/refs/tags/bun-v${bunversion}/packages/bun-release/scripts/upload-assets.ts" | awk '/\/\/ robobun@oven\.sh/{print $1}' | tr -d '",')
curl -Ss "https://keys.openpgp.org/vks/v1/by-fingerprint/${fingerprint}"
